# Server port
PORT=3000

# MongoDB connection string (local default shown; use your Atlas URI if hosted)
MONGO_URI=mongodb://127.0.0.1:27017/webmarket

# Secret used to sign JWT tokens — never commit a real value
JWT_SECRET=replace_with_a_long_random_local_secret

# Origin allowed by CORS (the React dev server)
CLIENT_ORIGIN=http://localhost:5173
